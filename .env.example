# Copy this file to .env and replace the placeholder values.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=cloud
LLM_MODEL=gpt-4o-mini
# LLM request timeout in seconds; increase this for slower local models.
OPENAI_TIMEOUT=20
FOODGUARD_OFFLINE=1

# Web Search MCP. Set WEB_SEARCH_ENABLED=true in a deployment that allows
# outbound HTTPS. duckduckgo is a no-key development fallback; hosted
# providers can be selected with WEB_SEARCH_PROVIDER and WEB_SEARCH_API_KEY.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT=12

# Local project paths (Windows-compatible relative paths)
TFDA_DOCUMENTS_DIR=documents
VECTOR_STORE_DIR=data/vector_store
FOODGUARD_AUTO_BUILD_INDEX=0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOG_LEVEL=INFO
FOODGUARD_MEMORY_DB=data/foodguard_memory.db

# MCP server defaults
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
